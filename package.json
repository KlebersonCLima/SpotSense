{
  "name": "spotsense",
  "private": true,
  "description": "SpotSense — plataforma inteligente de gerenciamento de estacionamentos com integração IoT (ESP32 + Supabase + Nuxt).",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @spotsense/web dev",
    "build": "pnpm --filter @spotsense/web build",
    "preview": "pnpm --filter @spotsense/web preview",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  }
}
